# Database
DATABASE_URL=postgresql://osig:osig_dev_pass@localhost:5433/osig_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# App
DEBUG=True
PROJECT_NAME=OSIG - Open Source Intelligence Gathering
API_V1_PREFIX=/api/v1


# Scan execution: celery (needs a worker) or thread (dev only)
SCAN_EXECUTOR=celery
# Per-client-IP limits (slowapi syntax)
# RATE_LIMIT_AUTH=10/minute
# RATE_LIMIT_SCANS=20/hour
# RATE_LIMIT_EMAIL=5/hour
# Opt-in active port scanning on deep domain scans
ENABLE_PORT_SCAN=false
# Optional API keys
HIBP_API_KEY=
EMAILREP_API_KEY=
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
GITHUB_TOKEN=

# Sign in with Google (Google Cloud > APIs & Services > Credentials > OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000
ABUSEIPDB_API_KEY=
OPENCORPORATES_API_TOKEN=
NUMVERIFY_API_KEY=
# Sanctions / PEP screening (https://www.opensanctions.org/api/). Data is CC BY-NC 4.0:
# free for non-commercial use only - a paid SaaS like OSIG needs an OpenSanctions commercial licence.
OPENSANCTIONS_API_KEY=
# AlienVault (LevelBlue) OTX pulses/malware for domains and IPs (free key; review the OTX EULA
# for commercial use before enabling in production)
OTX_API_KEY=
# GreyNoise. Without a key the Community API is used, which GreyNoise offers for non-commercial use;
# set a (paid) key for commercial deployments.
GREYNOISE_API_KEY=
# ransomware.live victim search (ransomware leak-site claims, onion host only, never fetched).
# Off by default: its free API terms were not confirmed for commercial use - check / buy PRO first.
ENABLE_RANSOMWARE_LIVE=false
# ICIJ Offshore Leaks (no key; ODbL / CC BY-SA, attribution required) and GitHub code search
# for leaked secrets (needs GITHUB_TOKEN above) run automatically.

# Email (verification, password reset, watch alerts). Unset = recorded in mail_outbox only
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=OSIG <no-reply@example.com>
SMTP_STARTTLS=true
# Delete scans older than N days for everyone (0 = keep)
DATA_RETENTION_DAYS=0

# Billing through Yoon (https://github.com/crossben/yoonpay). Empty = billing off.
# Local demo gateway: docker compose -f docker-compose.yoon.yml --env-file .env.yoon up -d
YOON_API_URL=
YOON_API_KEY=
YOON_WEBHOOK_SECRET=
# BILLING_GRACE_DAYS=2
# BILLING_REMINDER_DAYS=7

# Web Push for footprint alerts (VAPID). Empty = push off. Generate a pair with:
#   .venv/bin/python -c "from py_vapid import Vapid01 as V; import base64; from cryptography.hazmat.primitives import serialization as s; v=V(); v.generate_keys(); b=lambda x: base64.urlsafe_b64encode(x).rstrip(b'=').decode(); print('VAPID_PUBLIC_KEY='+b(v.public_key.public_bytes(s.Encoding.X962, s.PublicFormat.UncompressedPoint))); print('VAPID_PRIVATE_KEY='+b(v.private_key.private_numbers().private_value.to_bytes(32,'big')))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# No SMS provider yet: phone identities can be added but stay unverified and unwatched
SMS_ENABLED=false
# RATE_LIMIT_FOOTPRINT_REFRESH=3/hour
# Operator API for one-off migration scripts only
YOON_ADMIN_TOKEN=
YOON_APPLICATION_ID=
# Scam checker: known-bad link lists (optional)
# Google Web Risk Lookup API key (Google Cloud; 100k lookups/month free, then paid)
GOOGLE_WEB_RISK_API_KEY=
# abuse.ch URLhaus Auth-Key (free at auth.abuse.ch; for-profit use may need Spamhaus' commercial API)
URLHAUS_AUTH_KEY=
