# Database
DATABASE_URL=postgresql://osig:osig_dev_pass@localhost:5432/osig_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# App
DEBUG=True
PROJECT_NAME=OSIG - Open Source Intelligence Gathering
API_V1_PREFIX=/api/v1

# User Plans Daily Limits
FREE_DAILY_SCANS=5
PRO_DAILY_SCANS=50
ENTERPRISE_DAILY_SCANS=999999
